---
/** Plantilla de artículo: noticias, filtraciones y páginas de la guía */
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Credito from '../components/Credito.astro';
import { SITE } from '../config/site';
import { formatDate } from '../utils/content';

export interface Props {
  data: {
    titulo: string;
    descripcion: string;
    fecha: Date;
    actualizado?: Date;
    imagen?: ImageMetadata;
    imagenAlt?: string;
    imagenCredito?: string;
    etiquetas: string[];
  };
  breadcrumbs: { label: string; href?: string }[];
  schemaType?: 'NewsArticle' | 'Article';
}

const { data, breadcrumbs, schemaType = 'Article' } = Astro.props;

// Imagen para compartir en redes (1200x630). Si el artículo no tiene imagen se usa la de por defecto.
const social = data.imagen
  ? (await getImage({ src: data.imagen, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : SITE.defaultImage;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  headline: data.titulo,
  description: data.descripcion,
  image: [new URL(social, Astro.site).href],
  datePublished: data.fecha.toISOString(),
  dateModified: (data.actualizado ?? data.fecha).toISOString(),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout
  title={data.titulo}
  description={data.descripcion}
  image={social}
  type="article"
  publishedTime={data.fecha}
  modifiedTime={data.actualizado}
  jsonLd={jsonLd}
>
  <article class="container article">
    <Breadcrumbs items={[...breadcrumbs, { label: data.titulo }]} />
    <header class="article-header">
      <h1>{data.titulo}</h1>
      <p class="lead">{data.descripcion}</p>
      <p class="small muted">
        <time datetime={data.fecha.toISOString()}>{formatDate(data.fecha)}</time>
        {data.actualizado && <> · Actualizado el <time datetime={data.actualizado.toISOString()}>{formatDate(data.actualizado)}</time></>}
      </p>
      <slot name="aviso" />
    </header>

    {data.imagen && (
      <figure class="article-figure">
        <Image
          class="article-image"
          src={data.imagen}
          alt={data.imagenAlt ?? data.titulo}
          widths={[640, 960, 1280, 1640]}
          sizes="(max-width: 860px) 100vw, 820px"
          format="webp"
          loading="eager"
        />
        <figcaption><Credito credito={data.imagenCredito} /></figcaption>
      </figure>
    )}

    <div class="prose">
      <slot />
    </div>

    {data.etiquetas.length > 0 && (
      <ul class="inline-list tags">{data.etiquetas.map((t) => <li class="tag">{t}</li>)}</ul>
    )}
  </article>
</BaseLayout>

---
/** Plantilla de página simple: listados, contacto, legal, FAQ... */
import BaseLayout, { type Props as BaseProps } from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

export interface Props extends BaseProps {
  heading: string;
  intro?: string;
  breadcrumbs?: { label: string; href?: string }[];
  // Botón redondo «volver» a la derecha del título, p. ej. { href: '/multimedia/', label: 'Multimedia' }
  volver?: { href: string; label: string };
}

const { heading, intro, breadcrumbs = [], volver, ...seo } = Astro.props;
---

<BaseLayout {...seo}>
  <section class="container page">
    <Breadcrumbs items={[...breadcrumbs, { label: heading }]} />
    <header class="page-header">
      <div class="page-title">
        <h1>{heading}</h1>
        {volver && (
          <a class="boton-volver" href={volver.href} aria-label={`Volver a ${volver.label}`} title={`Volver a ${volver.label}`}>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
          </a>
        )}
      </div>
      {intro && <p class="lead">{intro}</p>}
    </header>
    <slot />
  </section>
</BaseLayout>

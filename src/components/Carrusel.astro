---
/**
 * Carrusel horizontal (se desplaza con la barra, la rueda o el dedo) con título enlazado
 * y una tarjeta final «Ver más» que lleva a la página con todos los elementos.
 * Los elementos se pasan como hijos (<li>…</li>).
 */
export interface Props {
  titulo: string;
  href: string;
  // Texto de la tarjeta final, p. ej. "Todos los vídeos"
  verMas: string;
  // Nota de fuente bajo el carrusel
  fuente?: string;
}

const { titulo, href, verMas, fuente } = Astro.props;
---

<section class="carrusel">
  <h2><a class="carrusel-titulo" href={href}>{titulo} <span aria-hidden="true">→</span></a></h2>

  <ul class="carrusel-pista">
    <slot />
    <li>
      <a class="ver-mas" href={href}>
        <span class="ver-mas-icono" aria-hidden="true">→</span>
        <strong>Ver más</strong>
        <span class="small muted">{verMas}</span>
      </a>
    </li>
  </ul>

  {fuente && <p class="credito carrusel-fuente">{fuente}</p>}
</section>

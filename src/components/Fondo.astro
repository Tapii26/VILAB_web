---
/**
 * Sección con imagen de fondo a pantalla completa y el contenido centrado encima.
 * Uso: <Fondo imagen={miImagen} credito="Rockstar Games"> ... </Fondo>
 * Las imágenes de fondo van en src/assets/fondos/ (se optimizan solas).
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Credito from './Credito.astro';

export interface Props {
  imagen: ImageMetadata;
  credito?: string;
  // Posición del encuadre (CSS object-position), p. ej. "center" o "70% 30%"
  posicion?: string;
}

const { imagen, credito, posicion = 'center' } = Astro.props;
const img = await getImage({ src: imagen, widths: [828, 1280, 1920, 2560], format: 'webp' });
---

<section class="fondo">
  <img
    class="fondo-img"
    src={img.src}
    srcset={img.srcSet.attribute}
    sizes="100vw"
    alt=""
    decoding="async"
    style={`object-position: ${posicion}`}
  />
  <div class="container fondo-content">
    <slot />
  </div>
  <Credito credito={credito} class="fondo-credito" />
</section>

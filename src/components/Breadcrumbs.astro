---
/** Migas de pan visibles + datos estructurados BreadcrumbList para Google */
export interface Props {
  items: { label: string; href?: string }[];
}

const items = [{ label: 'Inicio', href: '/' }, ...Astro.props.items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href && { item: new URL(item.href, Astro.site).href }),
  })),
};
---

<nav class="breadcrumbs small" aria-label="Migas de pan">
  <ol>
    {items.map((item, i) => <li>{item.href ? <a href={item.href}>{item.label}</a> : <span aria-current={i === items.length - 1 ? 'page' : undefined}>{item.label}</span>}</li>)}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

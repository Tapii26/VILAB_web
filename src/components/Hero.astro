---
/**
 * Banner principal de la portada. La imagen se configura en HERO (src/config/site.ts).
 * Astro genera versiones WebP en varios tamaños y el navegador descarga solo la que necesita.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { HERO } from '../config/site';
import Countdown from './Countdown.astro';
import Credito from './Credito.astro';

const banners = import.meta.glob<{ default: ImageMetadata }>('/src/assets/banners/*.{jpg,jpeg,png,webp}', { eager: true });
const cargar = (nombre: string) => {
  const img = banners[`/src/assets/banners/${nombre}`]?.default;
  if (!img) throw new Error(`Banner no encontrado: src/assets/banners/${nombre}`);
  return img;
};

const escritorio = await getImage({ src: cargar(HERO.imagen), widths: [960, 1600, 2560, 3840], format: 'webp' });
const movil = HERO.imagenMovil
  ? await getImage({ src: cargar(HERO.imagenMovil), widths: [480, 828, 1080], format: 'webp' })
  : undefined;
---

<section class="hero">
  <picture>
    {movil && <source media="(max-width: 700px)" srcset={movil.srcSet.attribute} sizes="100vw" type="image/webp" />}
    <source srcset={escritorio.srcSet.attribute} sizes="100vw" type="image/webp" />
    <img class="hero-img" src={escritorio.src} alt={HERO.alt} fetchpriority="high" decoding="async" />
  </picture>

  <div class="container hero-content">
    <slot />
    <Countdown />
  </div>

  <Credito credito={HERO.credito} class="hero-credito" />
</section>
